# ─── App ──────────────────────────────────────────
APP_NAME=CuraWeave
APP_URL=http://localhost:3000
ENVIRONMENT=development
DEBUG=true

# ─── Database (PostgreSQL for production, SQLite for local) ──
# SQLite (no Docker needed):
# DATABASE_URL=sqlite+aiosqlite:///./data/curaweave.db
# SYNC_DATABASE_URL=sqlite:///./data/curaweave.db
# PostgreSQL (Docker):
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/curaweave
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/curaweave

# ─── Redis ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ───────────────────────────────────
SECRET_KEY=change-me-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── AI / LLM ───────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
ENABLE_FALLBACK_PARSER=true

# ─── Twilio (WhatsApp) - Optional ───────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# ─── Razorpay (Billing) - Optional ──────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── SMTP Email - Optional ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── Sentry - Optional ──────────────────────────
SENTRY_DSN=

# ─── CORS & HTTPS ───────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENFORCE_HTTPS=false

# ─── Password Policy ────────────────────────────
MIN_PASSWORD_LENGTH=8
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
VERIFICATION_TOKEN_EXPIRE_HOURS=48
